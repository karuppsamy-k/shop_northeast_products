rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Common function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if the user has an admin role
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -- Users Collection --
    match /users/{userId} {
      // Users can read/write their own document
      // Admins can read/write any user document
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // -- Orders Collection --
    match /orders/{orderId} {
      // Users can read their own orders (we check the userId field in the doc)
      // Admins can read all orders
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can create orders for themselves
      // Admins can create any orders (or update them)
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // -- Products Collection --
    match /products/{productId} {
      // Anyone (even unauthenticated) can read products
      allow read: if true;
      
      // Only admins can write/delete products
      allow write, delete: if isAdmin();
    }

    // -- Notifications Collection --
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, delete: if isAdmin();
    }
  }
}
